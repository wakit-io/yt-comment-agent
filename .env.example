# YT 댓글 어시스턴트 — 환경변수 예시. 이 파일을 .env 로 복사해서 값을 채우세요.
#   cp .env.example .env
# ⚠️ 실제 키는 .env 에만. .env 는 .gitignore 되어 저장소에 안 올라갑니다.

# ── Supabase (로컬: supabase start / 또는 본인 Supabase 프로젝트) ──
SUPABASE_URL=http://127.0.0.1:54821
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# ── 앱 ──
APP_ORIGIN=http://localhost:5210
PORT=5210
MASTER_EMAILS=            # 관리자 이메일(쉼표구분). 비우면 첫 로그인 사용자가 운영자.

# ── YouTube Data API 키 (영상 검색/맥락 읽기) ──
#   Google Cloud 콘솔 → API 및 서비스 → YouTube Data API v3 사용 설정 → API 키
YT_API_KEY=<youtube data api key>

# ── YouTube 게시(OAuth 2.0) — 본인 계정에 댓글 게시 ──
#   OAuth 동의화면 + OAuth 클라이언트(웹), 승인된 리디렉션 URI 에 아래 콜백 등록
GOOGLE_CLIENT_ID=<oauth client id>
GOOGLE_CLIENT_SECRET=<oauth client secret>
GOOGLE_OAUTH_REDIRECT=http://localhost:5210/auth/youtube/callback

# ── AI 댓글 초안 ──
AI_PROVIDER=google       # google | anthropic | openai
GEMINI_API_KEY=<gemini api key>
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
